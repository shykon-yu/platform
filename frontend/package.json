{
  "name": "we8-platform-client",
  "private": true,
  "version": "0.1.1",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:build": "npm run build && node scripts/download-softether.cjs && electron-builder --win nsis",
    "electron": "electron"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.8",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.we8.platform",
    "productName": "WEL职业联盟对战平台",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
